{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Routing Restriction Template",
  "type": "object",
  "required": ["name","rules"],
  "properties": {
    "id": { "type": "string", "description": "Optional UUID assigned by server" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "owner": { "type": "string", "description": "Optional owner id" },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string","null"], "format": "date-time" },
    "precedence": { "type": "integer", "default": 0, "description": "Higher wins when merging" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["filter","action"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "precedence": { "type": "integer", "default": 0 },
          "filter": {
            "type": "object",
            "description": "Define which arcs/nodes/ways are affected",
            "properties": {
              "arc_ids": { "type": "array", "items": { "type": "integer" } },
              "way_tags": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
              "bbox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4, "description": "[minLat,minLon,maxLat,maxLon]" },
              "polygon": {
                "type": "object",
                "description": "GeoJSON-like polygon: {type:'Polygon', coordinates: [ [ [lon,lat], ... ] ] }",
                "required": ["type","coordinates"],
                "properties": {
                  "type": { "const": "Polygon" },
                  "coordinates": { "type": "array" }
                }
              },
              "node_proximity": {
                "type": "object",
                "properties": {
                  "lat": { "type": "number" },
                  "lon": { "type": "number" },
                  "radius_m": { "type": "number" }
                }
              }
            },
            "additionalProperties": false
          },
          "action": {
            "type": "object",
            "description": "One or more actions to apply to filtered arcs",
            "properties": {
              "forbid": { "type": "boolean" },
              "weight_multiplier": { "type": "number" },
              "add_penalty": { "type": "number" },
              "set_weight": { "type": "number" },
              "add_flag": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
